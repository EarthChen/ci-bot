# CI 自愈 Bot — 环境变量模板
# 复制为 .env 并填入真实值：cp .env.example .env && chmod 600 .env
# .env 必须 chmod 600 且被 .gitignore 忽略，绝不能提交真实密钥。
# bot 通过配置加载器读取这些变量；缺失必填项会在启动时直接报错退出。

# ===================== GitLab =====================
# pipeline webhook 验签 token（GitLab 在请求头 X-Gitlab-Token 中发送）
GITLAB_WEBHOOK_SECRET=change-me-to-a-real-secret
# 项目访问令牌，需 read_repository + api 权限（供 glab CLI 调用）
GITLAB_TOKEN=glpat-change-me
# 自托管 GitLab 地址；使用 gitlab.com 时可留空
GITLAB_URL=https://gitlab.example.com

# ===================== 钉钉（Stream 模式） =====================
# 使用钉钉 Stream 模式 SDK（dingtalk-stream），不再是 webhook URL。
# 需在钉钉开放平台创建「企业内部应用」并开通 Stream 模式机器人。
# DINGTALK_CLIENT_ID = 应用的 AppKey
DINGTALK_CLIENT_ID=change-me-appkey
# DINGTALK_CLIENT_SECRET = 应用的 AppSecret
DINGTALK_CLIENT_SECRET=change-me-appsecret
# 默认通知群会话 ID（openConversationId），bot 据此主动推送通知
DINGTALK_CONVERSATION_ID=change-me-conversation-id

# ===================== Pi 相关路径 =====================
# bot 发布根目录（绝对路径，必填）。生产环境必须设置，确保 worker 只从
# bot 自有目录加载配置与 playbook，而不会误用目标项目 worktree 的配置。
# 典型值：/opt/ci-self-heal-bot
# 该目录应至少包含：
#   .pi/settings.json
#   src/agents/ci-repair/resources/   （APPEND_SYSTEM.md + ci-self-heal-playbook skill）
#   config/model-candidates.json
CIHEAL_BOT_ROOT=/opt/ci-self-heal-bot

# 部署挂载的 Pi 基础目录（绝对路径，必填，只读）。
# 每个 worker 启动时会把该目录下的 auth.json 和/或 models.json
# 拷贝到自己的私有运行时目录（<worker>/.pi-agent），权限收紧为仅属主可读。
# 因此目标仓库的 worktree 无法通过提交 .pi-agent 来注入模型认证或定义。
# 该目录必须至少包含 auth.json 或 models.json 之一。
# 典型值：/run/secrets/ci-self-heal-pi
# 说明：
#   - auth.json 只存「凭证」，不存 provider 定义；可为空文件 {}
#   - provider 列表（deepseek/openai/anthropic/qwen… 约 40 个）内置于 Pi SDK，
#     默认 builtin provider 公共端点「零配置」即可用，无需 models.json
#   - 走自定义网关（如本仓库默认的 MOMO本地）时，需要在 models.json 中声明
#     provider 名、baseUrl 与模型；可参考仓库 deploy/models.json.example
CIHEAL_PI_BASE_DIR=/run/secrets/ci-self-heal-pi

# 可写数据根（绝对路径，必填）。work / bare / audit / logs 全部派生自它：
#   <CIHEAL_DATA_ROOT>/work/    每事件临时工作区（事件后删除）
#   <CIHEAL_DATA_ROOT>/bare/    git bare clone 共享缓存（按 retention 清理）
#   <CIHEAL_DATA_ROOT>/audit/   审计轨迹（按 retention 清理）
#   <CIHEAL_DATA_ROOT>/logs/    主进程日志（pino-roll 轮转）
# 与 CIHEAL_BOT_ROOT（只读资源根）分离：一个根管资源，一个根管数据。
# 典型值：/var/lib/ci-self-heal
CIHEAL_DATA_ROOT=/var/lib/ci-self-heal

# ===================== 模型与密钥 =====================
# provider 选择顺序、模型 id 与 thinking/compaction 策略都写在 config/model-candidates.json
# 的每个候选中（bot-owned，非敏感），运行策略随候选内联，无需单独的 profile 文件。
# 模型密钥不在 .env 中配置：provider 级凭证随 CIHEAL_PI_BASE_DIR 的 auth.json /
# models.json 挂载（按 provider id 索引），由 SDK 在启动时直接读取。本段无需任何 *_API_KEY。

# --- 自定义模型 endpoint（可选）---
# 默认 deepseek 公共端点无需此文件。若要走公司网关 / 私有部署，
# 在 CIHEAL_PI_BASE_DIR 下放 models.json 覆盖对应 provider 的 baseUrl，例如：
# {
#   "providers": [
#     { "name": "deepseek", "baseUrl": "https://your-gateway.example.com/v1",
#       "models": [ { "id": "deepseek-chat" }, { "id": "deepseek-reasoner" } ] }
#   ]
# }
# 通用网关也可用内置的 radius provider：{"name":"radius","oauth":"radius","baseUrl":"..."}
# 详见 docs/pi-agent-configuration.md。

# ===================== Token 预算软上限 =====================
# 单个 session 累计 token 上限；超出则 abort 并发送钉钉告警
BOT_BUDGET_TOKENS=400000
# 单个 turn token 上限（偏紧，因为 abort 在 turn_end 之后才触发）
BOT_BUDGET_PER_TURN_TOKENS=200000

# ===================== 可观测性 =====================
# 每 1k token 成本（USD，估算），用于审计与指标；按 provider 实际价格调整
BOT_TOKEN_UNIT_COST_PER_1K=0.001
# worker 连续崩溃多少次后发送自警钉钉通知
BOT_WORKER_CRASH_THRESHOLD=3

# ===================== Bot 运行时 =====================
# 全局 worker 并发上限（v1 固定为 1）
BOT_CONCURRENCY=1
# GitLab 出网 IP/CIDR 白名单（逗号分隔；留空则不限制）
GITLAB_IP_ALLOWLIST=
# webhook 服务监听端口
PORT=8080
# Node 运行环境
NODE_ENV=development

# ===================== 供应链 =====================
# pnpm audit 需要支持 audit 端点的 npm registry；私有镜像若无 audit 端点会导致
# 审计静默通过。留空则使用已配置的 registry。
# npm_config_registry=https://registry.npmjs.org/

# ===================== 运行时 DI 开关（本地测试用，生产可省略） =====================
# 以下开关默认 real（见 src/main.ts）。本地 e2e 可用同名环境变量覆盖，例如：
#   CIHEAL_AGENT_MODE=real        # real=真实 pi SDK 会话；stub= canned 结果（不调 LLM）
#   CIHEAL_GLAB_MODE=real         # real=真实 glab 调 GitLab；fake=返回 canned CI log
#   CIHEAL_DINGTALK_MODE=fake     # 本地建议 fake，避免起真实 Stream WS / 推到真实群
# ===================== 运行时 DI / 模式开关（默认 real） =====================
# 主进程 src/main.ts 默认 real；本地 e2e 可用同名环境变量覆盖（如 CIHEAL_DINGTALK_MODE=fake）。
#   CIHEAL_AGENT_MODE:    real=真实 pi SDK 会话；stub= 返回 canned 结果（不调 LLM）
#   CIHEAL_GLAB_MODE:     real=真实 glab 调 GitLab；fake= 返回 canned CI log
#   CIHEAL_DINGTALK_MODE: real=真实 Stream 推送；fake= 仅写 dingtalk-sent.json 副作用文件（本地建议 fake）
CIHEAL_AGENT_MODE=real
CIHEAL_GLAB_MODE=real
CIHEAL_DINGTALK_MODE=real

# 另：e2e fixture 用 CIHEAL_STUB_CI_LOG(class1|class5) / CIHEAL_STUB_VERIFY(all-green|flaky)
#        / CIHEAL_SESSION_FACTORY=stub / CIHEAL_RESULT_FILE=<path>

# ===================== Worktree 模式（默认 real） =====================
# real= 真实 git clone --bare + worktree add；fake= 本地 git init（仅测试用）
CIHEAL_WORKTREE_MODE=real

# ===================== 日志级别 =====================
# trace | debug | info | warn | error（默认 info，见 src/util/log.ts）
LOG_LEVEL=info

# ===================== e2e 测试 fixture（仅测试用，生产留空） =====================
# CIHEAL_SESSION_FACTORY=stub
# CIHEAL_STUB_CI_LOG=class1          # 或 class5
# CIHEAL_STUB_VERIFY=all-green       # 或 flaky
# CIHEAL_STUB_FIX_KIND=
# CIHEAL_STUB_TURN_TOKENS=

