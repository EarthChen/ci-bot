# CI Self-Heal Bot — environment template
# Copy to `.env` and fill in real values. `.env` MUST be chmod 600 + gitignored.
# Bot reads via the config loader; never commit real secrets.

# --- GitLab ---
# Pipeline webhook secret token (sent as X-Gitlab-Token header by GitLab)
GITLAB_WEBHOOK_SECRET=change-me-to-a-real-secret
# Project access token with read_repository + api scope (for glab)
GITLAB_TOKEN=glpat-change-me
# Base URL for self-hosted GitLab (omit for gitlab.com)
GITLAB_URL=https://gitlab.example.com

# --- DingTalk (Stream 模式) ---
# 使用钉钉 Stream 模式 SDK（dingtalk-stream），而非 webhook URL。
# 需要在钉钉开放平台创建企业内部应用，开通 Stream 模式机器人。
# DINGTALK_CLIENT_ID = 应用的 AppKey
DINGTALK_CLIENT_ID=change-me-appkey
# DINGTALK_CLIENT_SECRET = 应用的 AppSecret
DINGTALK_CLIENT_SECRET=change-me-appsecret
# 默认通知群会话 ID（openConversationId），用于 bot 主动推送通知
DINGTALK_CONVERSATION_ID=change-me-conversation-id

# --- Bot-owned Pi runtime ---
# Absolute path to the unpacked bot release. Required in production so worker
# resources cannot be derived from a target project worktree.
CIHEAL_BOT_ROOT=/opt/ci-self-heal-bot
# Absolute directory mounted by deployment. It contains standard Pi auth.json
# and/or models.json; each worker copies the files into its private runtime.
# Never put auth.json in the release package or commit it to git.
CIHEAL_PI_BASE_DIR=/run/secrets/ci-self-heal-pi

# --- Model credentials (ticket 02+) ---
# Candidate order/model ids live in config/model-candidates.json; the linked
# Pi-compatible thinking/compaction policies live in config/model-profiles.json.
# Inject only the provider-specific keys needed by the deployment.
DEEPSEEK_API_KEY=change-me
# OPENAI_API_KEY=change-me
# ANTHROPIC_API_KEY=change-me
# Legacy single-provider compatibility (optional; candidates still control order).
# MODEL_PROVIDER=deepseek
# MODEL_API_KEY=change-me

# --- Budget soft limit (ticket 02) ---
# Total token cap per session; abort + DingTalk alert when exceeded.
BOT_BUDGET_TOKENS=200000
# Per-turn cap (aggressive, to catch overshoot since abort fires after turn_end).
BOT_BUDGET_PER_TURN_TOKENS=50000

# --- Observability (ticket 07) ---
# Cost per 1k tokens (USD, estimated). Used to compute per-fix cost in
# audit-trace.json + metrics.jsonl. Real value TBD per provider; see spec
# cost section. Monthly peak = N × daily-repairs × tokens × unit-price × 30.
BOT_TOKEN_UNIT_COST_PER_1K=0.001
# Consecutive worker crashes before a self-fault DingTalk alert.
BOT_WORKER_CRASH_THRESHOLD=3

# --- Bot runtime ---
# Global worker concurrency cap (ticket 05 lifts above 1)
BOT_CONCURRENCY=1
# Comma-separated GitLab egress IP allowlist (CIDR ok). Empty = skip allowlist.
GITLAB_IP_ALLOWLIST=
# Port the webhook server listens on
PORT=8080
# Node env
NODE_ENV=development

# --- Supply chain (ticket 06) ---
# pnpm audit needs the npm official registry (or a mirror that implements the
# audit endpoint). Private mirrors without an audit endpoint cause `pnpm audit`
# to exit 0 without scanning. Leave unset to use the configured registry.
# npm_config_registry=https://registry.npmjs.org/
