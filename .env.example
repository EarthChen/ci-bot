# CI Self-Heal Bot — environment template
# Copy to `.env` and fill in real values. `.env` MUST be chmod 600 + gitignored.
# Bot reads via the config loader; never commit real secrets.

# --- GitLab ---
# Pipeline webhook secret token (sent as X-Gitlab-Token header by GitLab)
GITLAB_WEBHOOK_SECRET=change-me-to-a-real-secret
# Project access token with read_repository + api scope (for glab)
GITLAB_TOKEN=glpat-change-me
# Base URL for self-hosted GitLab (omit for gitlab.com)
GITLAB_URL=https://gitlab.example.com

# --- DingTalk ---
# DingTalk custom-bot webhook URL (bot-side notification channel; agent never holds this)
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=change-me
DINGTALK_SECRET=change-me

# --- Model provider (ticket 02+) ---
# pi SDK reads these via ModelRuntime (env-based auth, no global auth.json needed).
# Provider id matching pi's built-in catalog (e.g. anthropic, openai, deepseek, etc.)
MODEL_PROVIDER=deepseek
# API key for the provider
MODEL_API_KEY=change-me

# --- Budget soft limit (ticket 02) ---
# Total token cap per session; abort + DingTalk alert when exceeded.
BOT_BUDGET_TOKENS=200000
# Per-turn cap (aggressive, to catch overshoot since abort fires after turn_end).
BOT_BUDGET_PER_TURN_TOKENS=50000

# --- Bot runtime ---
# Global worker concurrency cap (ticket 05 lifts above 1)
BOT_CONCURRENCY=1
# Comma-separated GitLab egress IP allowlist (CIDR ok). Empty = skip allowlist.
GITLAB_IP_ALLOWLIST=
# Port the webhook server listens on
PORT=8080
# Node env
NODE_ENV=development

# --- Supply chain (ticket 06) ---
# pnpm audit needs the npm official registry (or a mirror that implements the
# audit endpoint). Private mirrors without an audit endpoint cause `pnpm audit`
# to exit 0 without scanning. Leave unset to use the configured registry.
# npm_config_registry=https://registry.npmjs.org/
