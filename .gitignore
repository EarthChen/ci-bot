# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# environment secrets (NEVER commit)
.env
.env.*
!.env.example

# worker working dirs (per-event checkouts, isolated)
.work/
.worker-data/

# runtime state
*.log
logs/
data/
*.db
*.db-journal

# editor
.idea/
.vscode/
*.swp

# OS
.DS_Store

# subagent artifacts (transient)
.pi-subagents/

# durable audit traces + bot log (runtime artifacts, not source)
.audit/
.logs/

# Docker secrets (operator-managed, NEVER commit)
# 逐层展开才能重新包含嵌套的 *.example（父目录被排除时 ! 规则无效）
secrets/*
!secrets/pi
secrets/pi/*
!secrets/pi/*.example
