{
  "name": "ci-self-heal-bot",
  "version": "0.1.0",
  "private": true,
  "description": "CI unit-test self-healing bot: GitLab pipeline webhook → AI diagnosis → test-only fix → MR + DingTalk notification",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm --filter @ci-bot/dashboard build",
    "build:bot": "tsc -p tsconfig.json",
    "build:dashboard": "pnpm --filter @ci-bot/dashboard build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS='--max-old-space-size=8192' vitest run",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=8192' vitest",
    "audit": "pnpm audit --prod",
    "metrics": "node scripts/metrics-summary.mjs",
    "prestart": "pnpm build",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "dingtalk-stream": "2.1.6-beta.1",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "pino-roll": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
